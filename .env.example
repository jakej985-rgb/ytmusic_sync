# Timezone
TZ=America/Denver

# External HTTP Port for Web UI & API
PORT=8080

# Persistent Application Configuration Path (SQLite database, auth headers, logs)
CONFIG_PATH=./config

# Host Music Directories (Mounted strictly Read-Only into container)
MUSIC_PATH=/mnt/music
DOWNLOADS_PATH=/mnt/downloads

# Logging Verbosity (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# API Authentication Key
# Optional: If left blank, a secure random 32-byte key is automatically generated and saved to config/auth/api_key.txt
YTM_SYNC_API_KEY=

# Allowed CORS Origins (comma-separated). Set this to your external domain when accessing via reverse proxy.
# Defaults to http://localhost:8080,http://127.0.0.1:8080
# ALLOWED_ORIGINS=https://ytmsync.example.com,http://localhost:8080

# Optional Traefik Domain (if using Traefik reverse proxy)
TRAEFIK_HOST=ytmsync.example.com

